{
  "name": "care-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Home Care / Nursing Marketplace backend",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "test:bullmq": "jest --config jest.bullmq.config.js --runInBand --forceExit",
    "test:all": "npm test && npm run test:bullmq",
    "perf": "jest --config jest.perf.config.js --runInBand",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "seed:admin": "tsx src/database/seed-admin.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "seed:dummy": "tsx src/database/seed-dummy.ts",
    "seed:website": "tsx src/database/seed-website.ts",
    "seed:demo": "tsx src/database/seed-demo.ts",
    "demo:check": "tsx scripts/demo-check.ts",
    "seed:dummy:inspect": "tsx src/database/seed-inspect.ts",
    "seed:test:inspect": "tsx --env-file=.env.seed-test src/database/seed-inspect.ts",
    "seed:test": "tsx --env-file=.env.seed-test src/database/seed-dummy.ts",
    "vercel:env": "node scripts/vercel-env.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@sentry/node": "^10.76.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.11",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.5",
    "ms": "^2.1.3",
    "multer": "^2.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
