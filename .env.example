NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB MUST be a replica set (transactions). Docker compose provides rs0.
MONGODB_URI=mongodb://127.0.0.1:27017/care?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# JWT RS256. Base64-encoded PEM (or set *_FILE to a path for secret mounts).
# Generate with: npm run keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
JWT_ISSUER=care-backend
JWT_AUDIENCE=care-clients
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_COST=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006
TRUST_PROXY=false
SWAGGER_ENABLED=true
PLATFORM_TIMEZONE=Asia/Dubai

# Seed (npm run seed:admin) - fake/dev values only
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# Later phases (placeholders, never commit real values)
# mock (dev/test only, refuses production) | stripe
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# Run the finance sweeps (refund/payout retries, release, expiry) in-process every 30s until BullMQ (Phase 4)
INLINE_JOBS=false
# Phase 4: run BullMQ workers + scheduler inside the API process (or run `npm run worker` separately)
RUN_WORKERS=false
QUEUE_PREFIX=care
# Private file storage: local (dev, STORAGE_LOCAL_DIR) | s3 (S3-compatible, production) | memory (tests only; refused in production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage
# HMAC secret for short-lived private file URLs (REQUIRED in production, min 16 chars)
FILE_URL_SECRET=
# --- S3-compatible storage (STORAGE_PROVIDER=s3). Health data must stay in the UAE: me-central-1 on AWS.
S3_BUCKET=
S3_REGION=me-central-1
# Only for R2 / MinIO / other S3-compatible services:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# AES256 | aws:kms (AWS only)
S3_SERVER_SIDE_ENCRYPTION=AES256
# Credentials shared by S3 and SES. Prefer an instance/task role; never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Messaging. Production refuses to start without EMAIL_PROVIDER=ses and SMS_PROVIDER=twilio
#     (set ALLOW_NO_MESSAGING=true to run without them on purpose).
# Email: none (skipped) | log (dev: logs metadata only) | ses (Amazon SES)
EMAIL_PROVIDER=none
SES_REGION=
EMAIL_FROM=CareFlow <no-reply@example.com>
# SMS (phone verification codes): log (dev outbox) | none | twilio
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 number or registered alphanumeric sender ID (UAE requires sender registration) — or a messaging service:
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Push: none | expo (Expo Push API; the mobile app registers Expo push tokens)
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=
ALLOW_NO_MESSAGING=false
# Public website origin, used in emailed links (newsletter confirm/unsubscribe)
PUBLIC_WEB_URL=http://localhost:5174

# --- Error reporting (optional). Events are scrubbed of request data and personal details before sending.
SENTRY_DSN=
